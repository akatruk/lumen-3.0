    "captions": [
      {
        "text": "Open Lumen.",
        "startMs": 200,
        "endMs": 1185
      },
      {
        "text": "The screen says Sign in.",
        "startMs": 1185,
        "endMs": 3333
      },
      {
        "text": "Enter your email address and password, then choose Continue.",
        "startMs": 3333,
        "endMs": 8704
      },
      {
        "text": "Interface language only changes these buttons.",
        "startMs": 8704,
        "endMs": 12821
      },
      {
        "text": "It does not choose the voice in the finished video.",
        "startMs": 12821,
        "endMs": 17387
      },
      {
        "text": "Download video on this screen is the tutorial, not your project.",
        "startMs": 17387,
        "endMs": 23115
      },
      {
        "text": "After you sign in, open Video studio.",
        "startMs": 23933,
        "endMs": 27398
      },
      {
        "text": "New project shows the form.",
        "startMs": 27398,
        "endMs": 29927
      },
      {
        "text": "The heading is Learn the technique.",
        "startMs": 29927,
        "endMs": 33205
      },
      {
        "text": "Tell your story.",
        "startMs": 33205,
        "endMs": 34703
      },
      {
        "text": "A reference is required: one to five",
        "startMs": 34703,
        "endMs": 38075
      },
      {
        "text": "Douyin results, or a Reference video file.",
        "startMs": 38075,
        "endMs": 42008
      },
      {
        "text": "Analyze and build my plan stays off until your own",
        "startMs": 42008,
        "endMs": 46690
      },
      {
        "text": "video and at least one reference are both there.",
        "startMs": 46690,
        "endMs": 51186
      },
      {
        "text": "The reference is measured only.",
        "startMs": 51186,
        "endMs": 54089
      },
      {
        "text": "Its pictures, speech, and music do not enter the finished file.",
        "startMs": 54089,
        "endMs": 59989
      },
      {
        "text": "Choose your video to upload.",
        "startMs": 60800,
        "endMs": 63747
      },
      {
        "text": "Use one vertical file you own, from 30",
        "startMs": 63747,
        "endMs": 67746
      },
      {
        "text": "seconds to 7 minutes, up to 250 megabytes.",
        "startMs": 67746,
        "endMs": 72167
      },
      {
        "text": "Fill in Project name, Script and intended message, Topic, and Audience.",
        "startMs": 72167,
        "endMs": 79640
      },
      {
        "text": "Tick I own or have permission to edit this footage.",
        "startMs": 79640,
        "endMs": 85007
      },
      {
        "text": "Caption language is English or Simplified Chinese.",
        "startMs": 85007,
        "endMs": 90270
      },
      {
        "text": "That field is for subtitles, not the voice.",
        "startMs": 90270,
        "endMs": 94796
      },
      {
        "text": "Voice and style is a tone, such as calm and factual.",
        "startMs": 94796,
        "endMs": 100269
      },
      {
        "text": "It is not a voice id.",
        "startMs": 100269,
        "endMs": 102479
      },
      {
        "text": "Only your file becomes the project source.",
        "startMs": 102479,
        "endMs": 106899
      },
      {
        "text": "Wait until analysis finishes.",
        "startMs": 107700,
        "endMs": 110132
      },
      {
        "text": "A voiceover cannot be created until the first picture has a render.",
        "startMs": 110132,
        "endMs": 115750
      },
      {
        "text": "If style match is on, Approve this cut renders the saved edit.",
        "startMs": 115750,
        "endMs": 120949
      },
      {
        "text": "If it is off, save the plan,",
        "startMs": 120949,
        "endMs": 123297
      },
      {
        "text": "then choose Create video with these changes.",
        "startMs": 123297,
        "endMs": 126986
      },
      {
        "text": "This first file still uses the sound of your own footage.",
        "startMs": 126986,
        "endMs": 131766
      },
      {
        "text": "Save and refresh summary does not create a video.",
        "startMs": 131766,
        "endMs": 135875
      },
      {
        "text": "Review edits and create a version only opens the summary.",
        "startMs": 135875,
        "endMs": 140654
      },
      {
        "text": "An unsaved draft does not change the download.",
        "startMs": 140654,
        "endMs": 144511
      },
      {
        "text": "Open Edit, then Voiceover and language.",
        "startMs": 145333,
        "endMs": 149152
      },
      {
        "text": "The panel says Create a translated voiceover.",
        "startMs": 149152,
        "endMs": 153558
      },
      {
        "text": "It opens on Russian and ru-male.",
        "startMs": 153558,
        "endMs": 156692
      },
      {
        "text": "For this English film, set Voiceover language to",
        "startMs": 156692,
        "endMs": 161391
      },
      {
        "text": "English, and AI voice to Female — warm.",
        "startMs": 161391,
        "endMs": 165210
      },
      {
        "text": "That id is en-female.",
        "startMs": 165210,
        "endMs": 167266
      },
      {
        "text": "Preview voice makes a sample only.",
        "startMs": 167266,
        "endMs": 170596
      },
      {
        "text": "It is not the finished video.",
        "startMs": 170596,
        "endMs": 173435
      },
      {
        "text": "Choose Create dubbed version.",
        "startMs": 173435,
        "endMs": 176275
      },
      {
        "text": "The language and the voice must be this English pair.",
        "startMs": 176275,
        "endMs": 181464
      },
      {
        "text": "When the version is ready, Used in final video names en-female.",
        "startMs": 181464,
        "endMs": 187633
      },
      {
        "text": "Use original edit audio would remove that voice.",
        "startMs": 187633,
        "endMs": 192333
      },
      {
        "text": "Open the Audio tab.",
        "startMs": 193133,
        "endMs": 194857
      },
      {
        "text": "Under Background music, Track lists music you uploaded yourself.",
        "startMs": 194857,
        "endMs": 200664
      },
      {
        "text": "The empty choice is No added music.",
        "startMs": 200664,
        "endMs": 203840
      },
      {
        "text": "Choosing a track writes it into the edit draft.",
        "startMs": 203840,
        "endMs": 208104
      },
      {
        "text": "It is not the download yet.",
        "startMs": 208104,
        "endMs": 210554
      },
      {
        "text": "Add music to final video saves the edit,",
        "startMs": 210554,
        "endMs": 214183
      },
      {
        "text": "then mixes that track under the selected voice.",
        "startMs": 214183,
        "endMs": 218448
      },
      {
        "text": "The voice stays en-female.",
        "startMs": 218448,
        "endMs": 220807
      },
      {
        "text": "If you add no track, the finished file has no added music.",
        "startMs": 220807,
        "endMs": 226069
      },
      {
        "text": "Reference music is never copied.",
        "startMs": 226069,
        "endMs": 228973
      },
      {
        "text": "The tabs are Edit, Subtitles, Audio, Effects, Materials, and Review.",
        "startMs": 229800,
        "endMs": 235840
      },
      {
        "text": "Approve each scene.",
        "startMs": 235840,
        "endMs": 237528
      },
      {
        "text": "Saving the edit does not start a render, and an",
        "startMs": 237528,
        "endMs": 241703
      },
      {
        "text": "unsaved draft does not change the file you can download.",
        "startMs": 241703,
        "endMs": 246678
      },
      {
        "text": "If the picture should change, choose Approve this",
        "startMs": 246678,
        "endMs": 251031
      },
      {
        "text": "cut or Create video with these changes again.",
        "startMs": 251031,
        "endMs": 255028
      },
      {
        "text": "The same voice, en-female, is carried into the new picture.",
        "startMs": 255028,
        "endMs": 260269
      },
      {
        "text": "Lumen does not generate a new voice for that render.",
        "startMs": 260269,
        "endMs": 264888
      },
      {
        "text": "If the new edit does not cover the",
        "startMs": 264888,
        "endMs": 267908
      },
      {
        "text": "voice ranges, the current finished video stays.",
        "startMs": 267908,
        "endMs": 272083
      },
      {
        "text": "Wait until the project leaves rendering.",
        "startMs": 272900,
        "endMs": 276543
      },
      {
        "text": "In the header, choose Download video while the player shows Finished video.",
        "startMs": 276543,
        "endMs": 283375
      },
      {
        "text": "That file is the selected delivery: the new picture, the",
        "startMs": 283375,
        "endMs": 288476
      },
      {
        "text": "voice en-female, and your music track if you added one.",
        "startMs": 288476,
        "endMs": 293486
      },
      {
        "text": "The player and the download are the same file.",
        "startMs": 293486,
        "endMs": 297676
      },
      {
        "text": "A completed task is not proof by itself.",
        "startMs": 297676,
        "endMs": 301319
      },
      {
        "text": "If the render, the voice, or the music",
        "startMs": 301319,
        "endMs": 304780
      },
      {
        "text": "fails, the previous finished file stays in place.",
        "startMs": 304780,
        "endMs": 309243
      }
    ],
    "voice_id": "en-female"
  },

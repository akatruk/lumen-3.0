      "captions": [
        {
          "text": "Meet Lumen.",
          "startMs": 200,
          "endMs": 1225
        },
        {
          "text": "Turn your footage into a clearer, more purposeful video.",
          "startMs": 1225,
          "endMs": 6440
        },
        {
          "text": "Start with your story, learn from reference videos,",
          "startMs": 6440,
          "endMs": 11190
        },
        {
          "text": "and keep control of every editing decision.",
          "startMs": 11190,
          "endMs": 15195
        },
        {
          "text": "The Director Timeline connects your footage with specific",
          "startMs": 16000,
          "endMs": 21056
        },
        {
          "text": "editing ideas: pacing, framing, captions, graphics, and supporting visuals.",
          "startMs": 21056,
          "endMs": 27710
        },
        {
          "text": "Review the reasons, adjust the details, and approve only the shots you want.",
          "startMs": 27710,
          "endMs": 34451
        },
        {
          "text": "Match library footage to your scene, choose",
          "startMs": 35267,
          "endMs": 38459
        },
        {
          "text": "licensed music, or request an AI alternative.",
          "startMs": 38459,
          "endMs": 41799
        },
        {
          "text": "Lumen can review the rendered result and propose corrections.",
          "startMs": 41799,
          "endMs": 46328
        },
        {
          "text": "You review the changes before making another version.",
          "startMs": 46328,
          "endMs": 50262
        },
        {
          "text": "Prepare versions for Douyin, TikTok, Instagram Reels, YouTube Shorts, and Xiaohongshu.",
          "startMs": 51067,
          "endMs": 58754
        },
        {
          "text": "Review each cut, cover, caption style, and call to action.",
          "startMs": 58754,
          "endMs": 63939
        },
        {
          "text": "Download your files, then publish through your own channels.",
          "startMs": 63939,
          "endMs": 69302
        }
      ]
    },

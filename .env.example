# Copy to .env; never commit real keys.
OPENROUTER_API_KEY=
ANALYSIS_MODEL=google/gemini-3.8-flash
GENERATION_MODEL=google/veo-3.1-fast
LUMEN_INVITE_CODE=
SECURE_COOKIES=false
PUBLIC_ORIGIN=http://127.0.0.1:8019
DAILY_BUDGET_USD=20
MAX_UPLOAD_MB=250
MAX_DURATION_SECONDS=420
MAX_STORAGE_GB=8

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=andreykatruk@gmail.com
GOOGLE_SSO_ONLY=true

TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_DAILY_REQUESTS=100

# PostgreSQL in production; empty uses SQLite for local development.
DATABASE_URL=

# Stock voiceover generation through the existing OpenRouter key.
DUBBING_MODEL=minimax/speech-2.8-hd
# USD per million input characters, checked against provider pricing.
DUBBING_PRICE_PER_MILLION=100
